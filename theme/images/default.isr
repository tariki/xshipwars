#    ShipWars: Graphics and Videos Referance File
#
#	This file contains a list of graphics and video referances
#	(isrefs) that correspond to a graphic or video file.
#
#	Note: Isref 0 is considered the default, a non-existant or bad
#	isref inherits its data.
#
#
#       Format of this file is as follows:
#
#	BeginISRefEntry = i	Marks the beginning of an ISRef (Image
#                               Set Referance) configuration block for
#				isref number i.
#
#	EndISRefEntry		Marks the end of an ISRef configuration
#                               block.
#
#
#       ISRefEntry configuration block members:
#
#	FileName = s	Specifies the path to the image file associated
#			with this isref. The image format needs to be a
#			24 or 32 bit depth standard Targa file. If the
#			path is not absolute then the ImagesDir (specified
#			in the client configuration) will be prefixed
#			to it.
#
#	MergeMode = s	Specifies a code to determine the mathimatical
#			operation to be performed when blitting the image
#			to its destination buffer. Available values are:
#
#		Normal		Use direct assign (default).
#		Additive	Add source value to target value.
#		Subtractive	Subtract source value from target value.
#
#	HasTransparency		Specifies a hint to indicate the
#				image has transparent pixels (any pixel
#				of value 0, pitch black, is considered
#				transparent).
#
#	FrameDeterminat = s	Specifies which criteria to use to
#				determine which frame to draw. Available
#				values are:
#
#		ByHeading	Determine by current heading (default).
#		ByAnimation	Determine by current animation frame.
#
#
#	LayerPlacement = s	Specifies which visual layer to draw
#				this object in. Available values are:
#
#		Foreground		Foreground (default).
#		BackgroundTiled		Background tiled (scrolled).
#		BackgroundStatic	Background (static).
#
#
#	Effects = mask		Specifies any special effects to be
#				performed, this values need to be or'ed
#				togeather with the | operator.
#
#		StarGlow
#		FadeInGlow
#		FadeOutGlow
#
#
#	TotalFrames = ui	Specifies the total number of frames in
#				the image, must be 1 or greater.
#
#
#	LoadNow		Specifies to load this image on start up.
#			This must be specified last in the configuration
#			block.
#
#
#	NoImage		Specifies that this isref has no image and thus no
#			image will be attempted to be loaded when it is
#			requested.
#
#
#	StayLoaded	Specifies that this isref should remain loaded
#			even when no objects or resources referance it.
#			It is also not to be unloaded during memory
#			reclaiming.  It will only be unloaded when a
#			new isref file is loaded or when the program
#			exits.
#
#
#
#


# ############################################################################
#
#                              System Graphics
#

#   Isref number 0 is considered the 'default' image, when an object requests
#   an image set number that is not defined or not loadable, then this
#   image will be used.
#
#   If isref number 0 is not defined, then the program must use an internal
#   default image.
#
#BeginISRefEntry = 0
#    FileName = defaults/unknown.tga
#    MergeMode = Normal
#    HasTransparency
#    FrameDeterminat = ByHeading
#    LayerPlacement = Foreground
#    Magnification = 1.0
#    TotalFrames = 1
#    StayLoaded
#EndISRefEntry


#   Isrefs 10 to 19 are reserved for 'Stream Weapons' which do not need
#   images.
#

BeginISRefEntry = 10
    NoImage
EndISRefEntry

BeginISRefEntry = 11
    NoImage
EndISRefEntry

BeginISRefEntry = 12
    NoImage
EndISRefEntry

BeginISRefEntry = 13
    NoImage
EndISRefEntry

BeginISRefEntry = 14
    NoImage
EndISRefEntry

BeginISRefEntry = 15
    NoImage
EndISRefEntry

BeginISRefEntry = 16
    NoImage
EndISRefEntry

BeginISRefEntry = 17
    NoImage
EndISRefEntry

BeginISRefEntry = 18
    NoImage
EndISRefEntry

BeginISRefEntry = 19
    NoImage
EndISRefEntry



#   Isrefs 20 to 29 are standardized graphics, do not change their values!
#

# Explosion 1: Small firy explosion.
#
BeginISRefEntry = 20
    FileName = effects/explosion1.tga
    MergeMode = Additive
    FrameDeterminat = ByAnimation
    LayerPlacement = Foreground
    Magnification = 1.0
    TotalFrames = 4
    StayLoaded
    LoadNow
EndISRefEntry

# Explosion 2: Medium firy explosion.
#
BeginISRefEntry = 21
    FileName = effects/explosion2.tga
    MergeMode = Additive
    FrameDeterminat = ByAnimation
    LayerPlacement = Foreground
    Magnification = 1.0
    TotalFrames = 4
    StayLoaded
    LoadNow
EndISRefEntry

# Explosion 3: Large firy explosion.
#
BeginISRefEntry = 22
    FileName = effects/explosion3.tga
    MergeMode = Additive
    FrameDeterminat = ByAnimation
    LayerPlacement = Foreground
    Effects = FadeOutGlow
    Magnification = 2.0
    TotalFrames = 6
    StayLoaded
    LoadNow
EndISRefEntry

# Explosion 4: Large mass explosion.
#
BeginISRefEntry = 23
    FileName = effects/explosion4.tga
    MergeMode = Additive
    FrameDeterminat = ByAnimation
    LayerPlacement = Foreground
    Effects = FadeOutGlow
    Magnification = 5.0
    TotalFrames = 6
    StayLoaded
    LoadNow
EndISRefEntry



