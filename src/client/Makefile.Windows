# ########################################################################
#
#                  Makefile for XShipWars Client (Windows)
#
#   HAVE_SDL_MIXER and JS_SUPPORT are described in Makefile.Darwin.
#

include Makefile.srclist
SRC := $(subst osw-x.cpp,osw-sdl.cpp,$(SRC))

BIN_NAME = xsw
SDL_FILTER = -Dmain=SDL_main -lSDL2main -mwindows
CFLAGS := -DOSW_SDL -DXSW_WIN32_GUI -DSDL_MAIN_HANDLED -DHAVE_SDL_MIXER -DJS_SUPPORT \
	$(filter-out $(SDL_FILTER),$(shell pkg-config --cflags SDL2_mixer))
LIB := $(filter-out $(SDL_FILTER),$(shell pkg-config --libs SDL2_mixer)) -mwindows

include ../compat/win32/Makefile.inc
