# ########################################################################
#
#                       Makefile for Monitor (Windows)
#

include Makefile.srclist
SRC := $(subst osw-x.cpp,osw-sdl.cpp,$(SRC))

BIN_NAME = monitor
SDL_FILTER = -Dmain=SDL_main -lSDL2main -mwindows
CFLAGS := -DOSW_SDL \
	$(filter-out $(SDL_FILTER),$(shell pkg-config --cflags sdl2))
LIB := $(filter-out $(SDL_FILTER),$(shell pkg-config --libs sdl2))

include ../compat/win32/Makefile.inc
