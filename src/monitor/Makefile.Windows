# ########################################################################
#
#                       Makefile for Monitor (Windows)
#

include Makefile.srclist
SRC := $(subst osw-x.cpp,osw-sdl.cpp,$(SRC))

BIN_NAME = monitor
SDL_FILTER = -Dmain=SDL_main -lSDL2main -mwindows
CFLAGS := -DOSW_SDL -DXSW_WIN32_GUI -DSDL_MAIN_HANDLED \
	$(filter-out $(SDL_FILTER),$(shell pkg-config --cflags sdl2))
LIB := $(filter-out $(SDL_FILTER),$(shell pkg-config --libs sdl2)) -mwindows

include ../compat/win32/Makefile.inc

#   Installed as on macOS: the program in $(PREFIX)/bin.
GAMES_DIR = $(PREFIX)/bin
DLL_DIR = $(GAMES_DIR)
include Makefile.install.UNIX
